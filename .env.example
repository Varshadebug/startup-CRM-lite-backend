# Server Port (Render provides PORT automatically)
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/startup-crm?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_key_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Environment Mode (production / development)
NODE_ENV=production

# Frontend Origin URL for CORS (without trailing slash, supports comma-separated URLs)
FRONTEND_URL=https://startup-crm-lite-alpha.vercel.app
